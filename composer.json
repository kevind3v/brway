{
  "name": "brbunny/brway",
  "description": "Roteador PHP simples para MVC e APIs: verbos RESTful, grupos, rotas nomeadas, middlewares e form spoofing.",
  "keywords": [
    "BrWay",
    "Router",
    "Route",
    "Routes",
    "Middleware",
    "MVC"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Kevin Siqueira",
      "role": "Maintainer"
    },
    {
      "name": "Robson V. Leite",
      "email": "cursos@upinside.com.br",
      "role": "Original author (CoffeeCode Router)"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "BrWay\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BrWay\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
